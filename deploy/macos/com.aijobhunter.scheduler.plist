<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs Laravel's scheduler once a minute (equivalent of the classic cron entry). -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.aijobhunter.scheduler</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PHP__</string>
        <string>__APP_DIR__/artisan</string>
        <string>schedule:run</string>
    </array>
    <key>WorkingDirectory</key><string>__APP_DIR__</string>
    <key>EnvironmentVariables</key><dict><key>PATH</key><string>__PATH__</string></dict>
    <key>StartInterval</key><integer>60</integer>
    <key>RunAtLoad</key><true/>
    <key>StandardOutPath</key><string>__LOGS__/launchd-scheduler.log</string>
    <key>StandardErrorPath</key><string>__LOGS__/launchd-scheduler.log</string>
</dict>
</plist>
