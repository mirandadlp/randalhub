<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Optional: keeps the web UI available at http://127.0.0.1:8000 (uses built assets from `npm run build`). -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.aijobhunter.web</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PHP__</string>
        <string>__APP_DIR__/artisan</string>
        <string>serve</string>
        <string>--host=127.0.0.1</string>
        <string>--port=8000</string>
    </array>
    <key>WorkingDirectory</key><string>__APP_DIR__</string>
    <key>EnvironmentVariables</key>
    <dict><key>PATH</key><string>__PATH__</string><key>PHP_CLI_SERVER_WORKERS</key><string>4</string></dict>
    <key>KeepAlive</key><true/>
    <key>RunAtLoad</key><true/>
    <key>StandardOutPath</key><string>__LOGS__/launchd-web.log</string>
    <key>StandardErrorPath</key><string>__LOGS__/launchd-web.log</string>
</dict>
</plist>
