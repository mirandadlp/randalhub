APP_NAME="AI Job Hunter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
SCHEDULE_TIMEZONE=America/Los_Angeles

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=job_hunter
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="jobhunter@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AI Job Hunter
# ---------------------------------------------------------------------------
# Sanctum SPA auth: the host:port you open in the browser
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

# Anthropic Claude API (required for AI matching, resume parsing, application packages).
# Can also be set (encrypted) from Settings > Claude API; the Settings value wins.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Effort: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# USD per million tokens, used for cost tracking
ANTHROPIC_INPUT_PRICE_PER_MTOK=4.00
ANTHROPIC_OUTPUT_PRICE_PER_MTOK=20.00

# Email address that receives digests and priority alerts (defaults to the user's login email)
JOBHUNTER_NOTIFY_EMAIL=

# Optional: Adzuna job search API (https://developer.adzuna.com/) - leave blank to disable
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Outbound HTTP politeness
JOBHUNTER_HTTP_USER_AGENT="AIJobHunter/1.0 (personal job search; respects robots.txt)"
JOBHUNTER_HTTP_TIMEOUT=30
JOBHUNTER_REQUEST_DELAY_MS=500

# Playwright assisted application (Node.js). Leave blank to use Playwright's bundled Chromium.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
JOBHUNTER_NODE_BINARY=node
# Run the autofill browser headless (true only for testing; you need a visible browser to review)
JOBHUNTER_AUTOFILL_HEADLESS=false
